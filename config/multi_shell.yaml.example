shells:
  - shell-index: 1 # -c
    satellite-num: 240 # -N
    plane-num: 10 # -P
    needed-plane-num: 10 # -E
    orbit-inclination: 60 # -I
    height: 1000 # -H
    phase: 5 # -F
    initial-delta: 100 # -D
    offset: -1 # --offset
    fake: true # --fake
    cross-sphere: true # --cross-sphere
    ground-access: true # --ground-access
    external-topo: false
    routing-area: 1 # -r
    name-rule: wxwx-1 # --name-rule
    schedule: Random
    gen-flow: walker-neighbour
    flow-bandwidth: 1Gbps
    image: harbor.sail.se.sjtu.edu.cn/utils/test-suite:v0.2 # --image
  - shell-index: 2 # -c
    satellite-num: 560 # -N
    plane-num: 35 # -P
    needed-plane-num: 35 # -E
    orbit-inclination: 55 # -I
    height: 1000 # -H
    phase: 0 # -F
    initial-delta: 100 # -D
    offset: -1 # --offset
    fake: true # --fake
    cross-sphere: true # --cross-sphere
    ground-access: true # --ground-access
    routing-area: 2 # -r
    name-rule: wxwx-1 # --name-rule
  - shell-index: 3 # -c
    satellite-num: 648 # -N
    plane-num: 36 # -P
    needed-plane-num: 36 # -E
    orbit-inclination: 89 # -I
    height: 1500 # -H
    phase: 0 # -F
    initial-delta: 100 # -D
    offset: -1 # --offset
    fake: true # --fake
    cross-sphere: true # --cross-sphere
    ground-access: true # --ground-access
    routing-area: 3 # -r
    name-rule: wxwx-1 # --name-rule
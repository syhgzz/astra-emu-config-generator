# 指定 kubenet 模版文件名
TEMPLATE_NAME = kubenet_template.yaml

# 指定 shell-config 文件名
CONFIG_NAME = multi_shell.yaml

# 指定合并后 kubenet-config 文件名
MERGE_OUTPUT_NAME = multi-shell.yaml

# 指定输出目录中需要运行的 yaml 文件名
# 以此作为实验名
TEST ?= multi-shell

# --- generate multiple shells ---

# 用 shell-index 指定 shell-config 中需要生成配置的卫星壳层
# 壳层名默认 s1 s2 s3
SHELLS = 1 2 3

# --- generate one shell ---

# 用 shell-index 指定 shell-config 中需要生成配置的卫星壳层
SHELL_INDEX ?= 1 
SHELL_NAME ?= s1